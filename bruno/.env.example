# Copy to .env and fill values (gitignored). Optional alternative to Bruno Secrets UI.
# Reference in env vars as {{process.env.CRON_SECRET}} if you switch to that pattern.

# From apps/api Infisical / .env.local
CRON_SECRET=

# Clerk session JWT for an @admobihq.com ops user (short-lived; paste fresh when needed)
CLERK_JWT=

# Clerk session JWTs from customer-web and driver-web (their own Clerk instances)
CUSTOMER_JWT=
DRIVER_JWT=

# PAYSTACK_SECRET_KEY for the target environment (test key off production); signs webhook bodies
PAYSTACK_SECRET=
