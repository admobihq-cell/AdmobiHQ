meta {
  name: Invite staff
  type: http
  seq: 2
}

post {
  url: {{API_URL}}/v1/team
  body: json
  auth: bearer
}

auth:bearer {
  token: {{clerk_jwt}}
}

body:json {
  {
    "email": "new.staff@admobihq.com",
    "tier": "member",
    "roleId": 1
  }
}

docs {
  `tier`: admin, or member with a `roleId`.
}
