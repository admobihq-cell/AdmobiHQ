meta {
  name: Bulk review campaigns
  type: http
  seq: 4
}

post {
  url: {{API_URL}}/v1/campaigns/bulk-review
  body: json
  auth: bearer
}

auth:bearer {
  token: {{clerk_jwt}}
}

body:json {
  {
    "ids": [
      1,
      2
    ],
    "decision": "approved"
  }
}

docs {
  ids 1-100. Only `submitted` campaigns change; returns `{ updated, skipped }`. A reason is required to reject.
}
