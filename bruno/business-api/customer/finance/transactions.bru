meta {
  name: Transactions
  type: http
  seq: 2
}

get {
  url: {{API_URL}}/v1/customer/finance/transactions?range=30d&page=1&sort=date_desc
  body: none
  auth: bearer
}

auth:bearer {
  token: {{customer_jwt}}
}

docs {
  Filters: kind, q. sort: date_desc | date_asc | amount_desc | amount_asc.
}
