{
  "expo": {
    "name": "Admobi Driver",
    "slug": "admobihq-driver",
    "version": "0.0.1",
    "orientation": "portrait",
    "runtimeVersion": "0.0.1",
    "icon": "./assets/images/icon.png",
    "scheme": "admobihq-driver",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.admobihq.driver",
      "infoPlist": {
        "UIBackgroundModes": ["remote-notification"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FAF9F7",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "package": "com.admobihq.driver",
      "predictiveBackGestureEnabled": false,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      "expo-secure-store",
      "@maplibre/maplibre-react-native",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#000000",
          "imageWidth": 200,
          "ios": {
            "backgroundColor": "#000000",
            "image": "./assets/images/splash-icon.png",
            "resizeMode": "contain"
          },
          "android": {
            "backgroundColor": "#000000",
            "image": "./assets/images/splash-icon.png",
            "resizeMode": "contain",
            "imageWidth": 200
          }
        }
      ],
      "expo-updates",
      [
        "expo-notifications",
        {
          "color": "#0B6E4F",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Admobi to use your location to track your routes and screen-on time.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow Admobi to use your camera to photograph your ID and profile documents.",
          "photosPermission": "Allow Admobi to access your photos to upload your ID and profile documents."
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "organization": "admobi-media",
          "project": "admobi-hq"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "95dc4e3d-d29f-4513-917f-391207264047"
      }
    },
    "owner": "admobimedia",
    "updates": {
      "url": "https://u.expo.dev/95dc4e3d-d29f-4513-917f-391207264047"
    }
  }
}
