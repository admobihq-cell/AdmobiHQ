// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Lead {
  id                  Int       @id @default(autoincrement())
  contact_name        String    @default("")
  email               String
  company_name        String
  phone               String?
  audience            String // "campaign"
  cities              String[]  @default([])
  ad_formats          String[]  @default([])
  duration            String?
  budget_range        String? // "under_50k", "50k_150k", "150k_500k", "500k_plus", "not_sure"
  campaign_start_date DateTime?
  additional_info     String?
  status              String?   @default("new") // new, contacted, qualified, closed
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt

  @@index([created_at])
  @@index([status])
  @@index([budget_range])
  @@map("leads")
}

model FleetPartner {
  id                   Int      @id @default(autoincrement())
  email                String
  company_name         String
  primary_contact_name String
  phone                String
  city                 String // "Nairobi", "Mombasa", "Kisumu"
  fleet_types          String[]
  fleet_size           String?
  vehicles_active      String? // "yes", "no", "some"
  notes                String?
  status               String?  @default("pending") // "pending", "verified", "active"
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt

  @@index([created_at])
  @@index([city])
  @@index([status])
  @@index([city, status])
  @@map("fleet_partners")
}

model Driver {
  id            Int      @id @default(autoincrement())
  name          String
  phone         String
  email         String?
  city          String // "Nairobi", "Mombasa", "Kisumu"
  vehicle_type  String? // "taxi", "delivery_bike", "three_wheeler", "other"
  days_per_week String? // "1_2", "3_4", "5_6", "daily"
  heard_about   String? // "whatsapp", "facebook", "friend", "roadside", "other"
  status        String?  @default("pending") // "pending", "verified", "active"
  notes         String?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  @@index([created_at])
  @@index([city])
  @@index([status])
  @@index([vehicle_type])
  @@index([city, status])
  @@map("drivers")
}

model WaitlistEntry {
  id         Int      @id @default(autoincrement())
  email      String   @unique
  source     String?  @default("homepage")
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([created_at])
  @@map("waitlist_entries")
}

model MediaKitRequest {
  id         Int      @id @default(autoincrement())
  name       String
  email      String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([created_at])
  @@map("media_kit_requests")
}

model OpsPushToken {
  id              Int      @id @default(autoincrement())
  clerk_user_id   String
  expo_push_token String   @unique
  platform        String?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  @@index([clerk_user_id])
  @@map("ops_push_tokens")
}

model CustomerPushToken {
  id              Int      @id @default(autoincrement())
  expo_push_token String   @unique
  platform        String?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  @@map("customer_push_tokens")
}

model AnnouncementBroadcast {
  id               Int      @id @default(autoincrement())
  title            String
  body             String
  sent_by_clerk_id String
  sent_by_email    String
  target_count     Int      @default(0)
  delivered_count  Int      @default(0)
  invalid_count    Int      @default(0)
  status           String   @default("sent")
  created_at       DateTime @default(now())

  tickets PushTicket[]

  @@index([created_at])
  @@map("announcement_broadcasts")
}

/// One row per push message handed to Expo. A ticket only means Expo queued the
/// message; the delivery receipt fetched later is what proves FCM/APNs took it.
model PushTicket {
  id              Int      @id @default(autoincrement())
  ticket_id       String?  @unique
  expo_push_token String
  audience        String // "customer" | "ops"
  broadcast_id    Int?
  status          String   @default("pending") // pending | ok | error | expired
  error_code      String?
  error_message   String?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  broadcast AnnouncementBroadcast? @relation(fields: [broadcast_id], references: [id], onDelete: Cascade)

  @@index([status, created_at])
  @@index([broadcast_id])
  @@map("push_tickets")
}

/// Cross-app activity trail: who did what, when (ops, public forms, future customer apps).
model AuditEvent {
  id            Int      @id @default(autoincrement())
  app           String
  actor_type    String
  actor_user_id String?
  actor_email   String?
  action        String
  entity_type   String
  entity_id     String?
  summary       String
  metadata      Json?
  created_at    DateTime @default(now())

  @@index([created_at])
  @@index([entity_type, created_at])
  @@index([actor_email, created_at])
  @@index([app, created_at])
  @@map("audit_events")
}
