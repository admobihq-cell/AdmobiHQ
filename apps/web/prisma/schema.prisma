// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Lead {
  id                  Int       @id @default(autoincrement())
  contact_name        String    @default("")
  email               String
  company_name        String
  phone               String?
  audience            String // "campaign"
  cities              String[]  @default([])
  ad_formats          String[]  @default([])
  duration            String?
  budget_range        String? // "under_50k", "50k_150k", "150k_500k", "500k_plus", "not_sure"
  campaign_start_date DateTime?
  additional_info     String?
  status              String?   @default("new") // new, contacted, qualified, closed
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt
  deleted_at          DateTime?
  deleted_by_email    String?

  @@index([created_at])
  @@index([status])
  @@index([budget_range])
  @@index([deleted_at])
  @@map("leads")
}

model FleetPartner {
  id                   Int      @id @default(autoincrement())
  email                String
  company_name         String
  primary_contact_name String
  phone                String
  city                 String // "Nairobi", "Mombasa", "Kisumu"
  fleet_types          String[]
  fleet_size           String?
  vehicles_active      String? // "yes", "no", "some"
  notes                String?
  status               String?  @default("pending") // "pending", "verified", "active"
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt
  deleted_at           DateTime?
  deleted_by_email     String?

  @@index([created_at])
  @@index([city])
  @@index([status])
  @@index([city, status])
  @@index([deleted_at])
  @@map("fleet_partners")
}

model Driver {
  id            Int      @id @default(autoincrement())
  name          String
  phone         String
  email         String?
  city          String // "Nairobi", "Mombasa", "Kisumu"
  vehicle_type  String? // "taxi", "delivery_bike", "three_wheeler", "other"
  days_per_week String? // "1_2", "3_4", "5_6", "daily"
  heard_about   String? // "whatsapp", "facebook", "friend", "roadside", "other"
  status        String?  @default("pending") // "pending", "verified", "active"
  notes         String?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  deleted_at    DateTime?
  deleted_by_email String?

  @@index([created_at])
  @@index([city])
  @@index([status])
  @@index([vehicle_type])
  @@index([city, status])
  @@index([deleted_at])
  @@map("drivers")
}

model WaitlistEntry {
  id               Int      @id @default(autoincrement())
  email            String   @unique
  source           String?  @default("homepage")
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt
  deleted_at       DateTime?
  deleted_by_email String?

  @@index([created_at])
  @@index([deleted_at])
  @@map("waitlist_entries")
}

model MediaKitRequest {
  id               Int      @id @default(autoincrement())
  name             String
  email            String
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt
  deleted_at       DateTime?
  deleted_by_email String?

  @@index([created_at])
  @@index([deleted_at])
  @@map("media_kit_requests")
}

model OpsPushToken {
  id              Int      @id @default(autoincrement())
  clerk_user_id   String
  expo_push_token String   @unique
  platform        String?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  @@index([clerk_user_id])
  @@map("ops_push_tokens")
}

model CustomerPushToken {
  id                  Int      @id @default(autoincrement())
  expo_push_token     String   @unique
  platform            String?
  anonymous_device_id String?
  clerk_user_id       String?
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  @@index([anonymous_device_id])
  @@index([clerk_user_id])
  @@map("customer_push_tokens")
}

model DriverPushToken {
  id                  Int      @id @default(autoincrement())
  expo_push_token     String   @unique
  platform            String?
  anonymous_device_id String?
  clerk_user_id       String?
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  @@index([anonymous_device_id])
  @@index([clerk_user_id])
  @@map("driver_push_tokens")
}

model AnnouncementBroadcast {
  id               Int       @id @default(autoincrement())
  title            String
  body             String
  category         String    @default("announcement")
  image_url        String?
  sent_by_clerk_id String
  sent_by_email    String
  target_apps      String[]  @default(["customer-mobile"])
  target_count     Int       @default(0)
  delivered_count  Int       @default(0)
  invalid_count    Int       @default(0)
  status           String    @default("sent")
  created_at       DateTime  @default(now())
  deleted_at       DateTime?
  deleted_by_email String?

  tickets    PushTicket[]
  deliveries AnnouncementDelivery[]

  @@index([created_at])
  @@index([deleted_at])
  @@map("announcement_broadcasts")
}

/// One row per (broadcast, recipient) — written at send time for every
/// resolved recipient across all four target apps. This is what a signed-in
/// user's notification inbox reads from, so a delivery row only existing for
/// recipients who were eligible at send time is what keeps a new account
/// from ever seeing history from before they joined.
model AnnouncementDelivery {
  id            Int                   @id @default(autoincrement())
  broadcast_id  Int
  broadcast     AnnouncementBroadcast @relation(fields: [broadcast_id], references: [id], onDelete: Cascade)
  clerk_user_id String
  app           String
  title         String
  body          String
  image_url     String?
  category      String
  read_at       DateTime?
  created_at    DateTime              @default(now())

  @@index([clerk_user_id, app, created_at])
  @@index([broadcast_id])
  @@map("announcement_deliveries")
}

/// One row per push message handed to Expo. A ticket only means Expo queued the
/// message; the delivery receipt fetched later is what proves FCM/APNs took it.
model PushTicket {
  id              Int      @id @default(autoincrement())
  ticket_id       String?  @unique
  expo_push_token String
  audience        String // "customer" | "ops" | "driver"
  broadcast_id    Int?
  status          String   @default("pending") // pending | ok | error | expired
  error_code      String?
  error_message   String?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  broadcast AnnouncementBroadcast? @relation(fields: [broadcast_id], references: [id], onDelete: Cascade)

  @@index([status, created_at])
  @@index([broadcast_id])
  @@map("push_tickets")
}

/// Dormant scaffold for real customer auth. Nullable everywhere it's
/// referenced today; wiring up real auth later means populating clerk_user_id
/// and backfilling SupportCase.customer_id by matching email — no schema change.
model Customer {
  id            Int      @id @default(autoincrement())
  email         String   @unique
  name          String?
  phone         String?
  clerk_user_id String?  @unique
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  cases SupportCase[]

  @@map("customers")
}

model SupportCase {
  id                    Int       @id @default(autoincrement())
  customer_id           Int?
  customer              Customer? @relation(fields: [customer_id], references: [id])
  driver_clerk_user_id  String?
  contact_name          String
  contact_email         String
  contact_phone         String?
  anonymous_device_id   String?
  access_token_hash     String    @unique
  channel               String // "web" | "customer-web" | "customer-mobile"
  category              String    @default("general") // billing, campaign, technical, driver, general
  subject               String
  status                String    @default("open") // open, pending, resolved, closed
  priority              String    @default("normal") // low, normal, high, urgent
  assigned_to_clerk_id  String?
  assigned_to_email     String?
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt

  messages SupportMessage[]

  @@index([status, created_at])
  @@index([contact_email])
  @@index([assigned_to_clerk_id])
  @@index([driver_clerk_user_id])
  @@map("support_cases")
}

/// Email-level identity token, minted once the first time an email opens a
/// support case. Lets a device list all cases for that email without trusting
/// a bare email query param — see SupportCase.access_token_hash for the
/// equivalent per-case model this mirrors.
model SupportIdentity {
  id                  Int      @id @default(autoincrement())
  contact_email       String   @unique
  anonymous_device_id String?
  access_token_hash   String   @unique
  created_at          DateTime @default(now())

  @@map("support_identities")
}

model SupportMessage {
  id               Int         @id @default(autoincrement())
  case_id          Int
  case             SupportCase @relation(fields: [case_id], references: [id], onDelete: Cascade)
  author_type      String // "customer" | "ops"
  author_email     String?
  author_clerk_id  String?
  body             String
  internal_note    Boolean     @default(false)
  created_at       DateTime    @default(now())

  @@index([case_id, created_at])
  @@map("support_messages")
}

/// Cross-app activity trail: who did what, when (ops, public forms, future customer apps).
/// Ops-controlled visibility switches, e.g. showing the Deliveries placeholder
/// screens across customer-web, driver-web, and driver-mobile before the real
/// feature ships. Public and unauthenticated to read (flags are visibility
/// toggles, never secrets); Clerk ops JWT required to write.
model PlatformFlag {
  key              String   @id
  enabled          Boolean  @default(false)
  updated_by_email String?
  updated_at       DateTime @updatedAt

  @@map("platform_flags")
}

model OpsRole {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  permissions String[] @default([])
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  assignments OpsRoleAssignment[]

  @@map("ops_roles")
}

/// One custom OpsRole per Clerk org:member (org:admin bypasses this entirely).
model OpsRoleAssignment {
  clerk_user_id String   @id
  role_id       Int
  role          OpsRole  @relation(fields: [role_id], references: [id])
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  @@index([role_id])
  @@map("ops_role_assignments")
}

/// One row per driver's profile-completion application, linked to the
/// DRIVER Clerk instance's user id — NOT the Driver model above, which is an
/// unrelated marketing lead-capture table with no clerk_user_id. Created by
/// the driver-web/driver-mobile profile-setup stepper, reviewed by ops.
model DriverProfile {
  id            Int    @id @default(autoincrement())
  clerk_user_id String @unique

  full_name          String?
  phone              String?
  city               String?
  national_id_number String?

  kra_pin String?

  payout_method        String? // "mpesa" | "bank"
  payout_mpesa_msisdn  String?
  payout_bank_name     String?
  payout_bank_account  String?

  status            String    @default("draft") // draft, submitted, approved, rejected, changes_requested
  submitted_at      DateTime?
  reviewed_at       DateTime?
  reviewed_by_email String?
  rejection_reason  String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  documents DriverDocument[]

  @@index([status, created_at])
  @@map("driver_profiles")
}

/// A single uploaded file for a driver profile step (National ID, profile
/// photo, KRA PIN certificate, payout proof). cloudinary_public_id is
/// private (Cloudinary "authenticated" delivery type) and never exposed to
/// the client directly — always served via an authenticated proxy route.
model DriverDocument {
  id                  Int           @id @default(autoincrement())
  profile_id          Int
  profile             DriverProfile @relation(fields: [profile_id], references: [id], onDelete: Cascade)
  type                String // national_id, profile_photo, kra_pin_certificate, payout_proof
  cloudinary_public_id String        @unique
  content_type        String
  size_bytes           Int
  original_filename    String?
  created_at           DateTime      @default(now())

  @@index([profile_id, type])
  @@map("driver_documents")
}

/// A per-driver in-app notification (application submitted / reviewed).
/// Written by the same routes that trigger the matching email — see
/// apps/api/app/v1/driver/profile/submit and
/// apps/api/app/v1/driver-applications/[id]/review.
model DriverNotification {
  id            Int    @id @default(autoincrement())
  clerk_user_id String

  type  String // application_submitted, application_approved, application_rejected, application_changes_requested
  title String
  body  String

  read_at    DateTime?
  created_at DateTime  @default(now())

  @@index([clerk_user_id, created_at])
  @@map("driver_notifications")
}

model AuditEvent {
  id            Int      @id @default(autoincrement())
  app           String
  actor_type    String
  actor_user_id String?
  actor_email   String?
  action        String
  entity_type   String
  entity_id     String?
  summary       String
  metadata      Json?
  created_at    DateTime @default(now())

  @@index([created_at])
  @@index([entity_type, created_at])
  @@index([actor_email, created_at])
  @@index([app, created_at])
  @@map("audit_events")
}

/// A third-party tool or service the business pays for or depends on.
/// Managed from ops → Settings → Integrations (admin only). `cost` is the
/// per-cycle price in `currency`; convert to a monthly USD figure in the app.
model Integration {
  id               Int      @id @default(autoincrement())
  name             String
  category         String   @default("infrastructure") // infrastructure, email, search-analytics, monitoring, automation, payments, developer, ai
  purpose          String   @default("")
  url              String   @default("")
  plan             String   @default("")
  cost             Decimal  @default(0) @db.Decimal(12, 2)
  currency         String   @default("USD") // USD, EUR, KES
  billing_cycle    String   @default("monthly") // monthly, annual, usage, free
  status           String   @default("active") // active, trial, review, canceled
  owner            String   @default("")
  notes            String   @default("")
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt
  updated_by_email String?

  @@index([category])
  @@index([status])
  @@map("integrations")
}
