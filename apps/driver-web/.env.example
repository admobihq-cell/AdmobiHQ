NEXT_PUBLIC_DRIVER_URL=http://localhost:3004
NEXT_PUBLIC_WEB_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3002
NEXT_PUBLIC_API_URL=http://localhost:3003

# Driver Clerk instance — separate from ops's and customer's, email/Google only
NEXT_PUBLIC_AUTH_ENABLED=false
NEXT_PUBLIC_DRIVER_CLERK_PUBLISHABLE_KEY=
DRIVER_CLERK_SECRET_KEY=

# Required because middleware.ts passes a non-default secretKey to
# clerkMiddleware() ("dynamic keys" — needed since this app's Clerk instance
# isn't the one in the plain CLERK_SECRET_KEY var). Any strong random value;
# doesn't need to match anything in the Clerk dashboard, and doesn't need to
# match the other apps' value either — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# See https://clerk.com/docs/reference/nextjs/clerk-middleware#dynamic-keys
CLERK_ENCRYPTION_KEY=

# Sentry — admobi-media / admobi-hq (inherits from ../web/.env.local in dev)
NEXT_PUBLIC_SENTRY_DSN=https://31b3bd4f4e11809c71541c8dcb24a3f4@o4511701700182016.ingest.de.sentry.io/4511701707194448
SENTRY_DSN=https://31b3bd4f4e11809c71541c8dcb24a3f4@o4511701700182016.ingest.de.sentry.io/4511701707194448
SENTRY_ORG=admobi-media
