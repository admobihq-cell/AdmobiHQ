{
  "name": "ops",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "node ../../scripts/copy-maplibre-worker.mjs && node ../../scripts/prisma-generate-safe.mjs && dotenv -e .env.local -e ../web/.env.local -- next dev --port 3001 --webpack",
    "build": "node ../../scripts/copy-maplibre-worker.mjs && node ../../scripts/prisma-generate-safe.mjs && next build --webpack",
    "start": "next start --port 3001",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "env:check": "dotenv -e .env.local -- tsx scripts/check-env.ts",
    "env:pull": "infisical export --env=dev --format=dotenv --output-file=.env.local",
    "env:pull:staging": "infisical export --env=staging --format=dotenv --output-file=.env.local"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.9.10",
    "@clerk/ui": "^1.38.1",
    "@hookform/resolvers": "^5.9.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@sentry/nextjs": "^10.64.0",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-table": "^8.21.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/functions": "^3.9.10",
    "@workspace/geo": "*",
    "@workspace/ops-api-client": "*",
    "@workspace/ops-contracts": "*",
    "@workspace/query-client": "*",
    "@workspace/sentry-config": "^0.0.0",
    "@workspace/ui": "*",
    "antd": "^6.6.5",
    "date-fns": "^4.1.0",
    "dotenv": "^16.6.1",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.50.0",
    "next": "^16.3.8",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.89.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^25.1.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@workspace/eslint-config": "*",
    "@workspace/typescript-config": "*",
    "dotenv-cli": "^8.0.0",
    "eslint": "^9.39.2",
    "prisma": "^7.8.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
