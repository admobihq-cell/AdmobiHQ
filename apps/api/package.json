{
  "name": "api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "node ../../scripts/prisma-generate-safe.mjs && dotenv -e .env.local -e ../web/.env.local -- next dev --port 3003 --webpack",
    "build": "node ../../scripts/prisma-generate-safe.mjs && next build --webpack",
    "start": "next start --port 3003",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "env:check": "dotenv -e .env.local -- tsx scripts/check-env.ts",
    "backfill:advertiser-orgs": "dotenv -e .env.local -- tsx scripts/backfill-advertiser-orgs.ts",
    "backfill:advertiser-orgs:prod": "dotenv -e ../web/.env.production.local -- tsx scripts/backfill-advertiser-orgs.ts",
    "env:pull": "infisical export --env=dev --format=dotenv --output-file=.env.local",
    "env:pull:staging": "infisical export --env=staging --format=dotenv --output-file=.env.local"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.9.22",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@sentry/nextjs": "^10.78.0",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.40.0",
    "@vercel/blob": "^2.8.2",
    "@vercel/functions": "^3.10.5",
    "@workspace/ops-contracts": "*",
    "@workspace/sentry-config": "^0.0.0",
    "antd": "^6.6.8",
    "cloudinary": "^2.11.0",
    "dotenv": "^16.6.1",
    "next": "^16.4.3",
    "pg": "^8.23.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-email": "^6.11.6",
    "resend": "^6.35.0",
    "takumi-pdf": "^0.19.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^25.1.0",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@workspace/eslint-config": "*",
    "@workspace/typescript-config": "*",
    "@workspace/vitest-config": "*",
    "dotenv-cli": "^8.0.0",
    "eslint": "^9.39.2",
    "prisma": "^7.10.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
