{"nodes": [{"id": "docs_shared_auth_three_clerk_instances", "label": "Three Independent Clerk Applications", "file_type": "rationale", "source_file": "docs/shared/AUTH.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A deliberate departure from the original plan to share one Clerk instance between customer and driver \u2014 splitting them removed a domain-primary/satellite conflict and all role-mismatch handling. Phone/SMS sign-in was also dropped in favor of email code + Google only across all three instances."}, {"id": "docs_shared_auth_auth_enabled_flag", "label": "AUTH_ENABLED Feature Flag", "file_type": "rationale", "source_file": "docs/shared/AUTH.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deliberately kept out of Infisical (local-only per environment) so a missing Clerk key can never crash the app \u2014 ClerkProvider simply never mounts and an AuthDisabledMessage renders instead, meaning auth availability differs per deployment rather than being centrally synced."}, {"id": "docs_shared_auth_opsrole_model", "label": "OpsRole / OpsRoleAssignment Model", "file_type": "concept", "source_file": "docs/shared/AUTH.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_shared_auth_signin_flow", "label": "Hand-Rolled Clerk Sign-In Flow", "file_type": "concept", "source_file": "docs/shared/AUTH.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_shared_auth_auth_enabled_flag", "target": "docs_customer_app_auth_enabled_gate", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/shared/AUTH.md", "source_location": null, "weight": 1.0}, {"source": "docs_shared_auth_opsrole_model", "target": "docs_ops_ops_admin_activity_au