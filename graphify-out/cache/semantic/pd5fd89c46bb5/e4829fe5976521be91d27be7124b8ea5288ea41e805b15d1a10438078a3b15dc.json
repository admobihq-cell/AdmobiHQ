{"nodes": [{"id": "apps_web_public_pricing_taxitop_formula", "label": "Taxi-top LED Spot/Play Pricing Formula", "file_type": "rationale", "source_file": "apps/web/public/pricing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Priced per play (spot/loop rotation) rather than per second, matching how taxi-top LED sells rotating inventory across screens; multipliers (slot length, zone, volume) are illustrative and confirmed per brief at booking."}, {"id": "apps_web_public_pricing_bike_enclosure_formula", "label": "Delivery Bike Enclosure Per-Side/Day Pricing Formula", "file_type": "rationale", "source_file": "apps/web/public/pricing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bike enclosures are static (non-digital) inventory, so a booked side is exclusive to the advertiser for the whole flight with no play rotation to share, unlike taxi-top LED \u2014 hence a per-side/per-day formula instead of a per-play one."}, {"id": "apps_web_public_pricing_zone_multiplier", "label": "Zone Multiplier Tiers", "file_type": "concept", "source_file": "apps/web/public/pricing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "apps_web_public_pricing_slot_multiplier", "label": "Slot Length Multiplier (Sub-linear)", "file_type": "concept", "source_file": "apps/web/public/pricing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "apps_web_public_pricing_volume_multiplier", "label": "Volume Multiplier", "file_type": "concept", "source_file": "apps/web/public/pricing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "apps_web_public_pricing_sides_multiplier", "label": "Sides Multiplier (Bike Enclosures)", "file_type": "concept", "source_file": "ap