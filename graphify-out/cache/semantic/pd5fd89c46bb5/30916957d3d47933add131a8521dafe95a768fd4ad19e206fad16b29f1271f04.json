l's disbursement product if it fits, otherwise Safaricom Daraja B2C."}, {"id": "docs_shared_roadmap_build_order", "label": "Build Order Milestones", "file_type": "concept", "source_file": "docs/shared/ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_shared_roadmap_telemetry_fulcrum", "target": "docs_api_api_rate_limiting", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/shared/ROADMAP.md", "source_location": null, "weight": 1.0}, {"source": "docs_shared_roadmap_driver_actor", "target": "docs_shared_roadmap_telemetry_fulcrum", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/shared/ROADMAP.md", "source_location": null, "weight": 1.0}, {"source": "docs_shared_roadmap_advertiser_actor", "target": "docs_shared_roadmap_pesapal_payments", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/shared/ROADMAP.md", "source_location": null, "weight": 1.0}, {"source": "docs_shared_roadmap_driver_actor", "target": "docs_shared_roadmap_pesapal_payments", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/shared/ROADMAP.md", "source_location": null, "weight": 1.0}, {"source": "docs_shared_roadmap_pesapal_payments", "target": "apps_web_public_pricing_taxitop_formula", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/shared/ROADMAP.md", "source_location": null, "weight": 1.0}], "hyperedges": []}