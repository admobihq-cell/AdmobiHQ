{"nodes": [{"id": "_agents_skills_impeccable_reference_critique_critique", "label": "Critique Command", "file_type": "document", "source_file": ".agents/skills/impeccable/reference/critique.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_agents_skills_impeccable_reference_critique_nielsen_heuristics", "label": "Nielsen's 10 Usability Heuristics", "file_type": "concept", "source_file": ".agents/skills/impeccable/reference/critique.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Provides a standardized, citable scoring rubric so critique feedback is comparable across runs and honest ('most real interfaces score 20-32/40')."}, {"id": "_agents_skills_impeccable_reference_critique_cognitive_load_assessment", "label": "Cognitive Load Assessment", "file_type": "concept", "source_file": ".agents/skills/impeccable/reference/critique.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Separates intrinsic, extraneous, and germane load so extraneous (pure waste) load can be eliminated ruthlessly while germane load is preserved."}, {"id": "_agents_skills_impeccable_reference_critique_working_memory_rule", "label": "The Working Memory Rule", "file_type": "concept", "source_file": ".agents/skills/impeccable/reference/critique.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Caps simultaneous options/items at roughly 4 because humans cannot reliably hold more in working memory; used to judge decision points and nav menus."}, {"id": "_agents_skills_impeccable_reference_critique_persona_based_testing", "label": "Persona-Based Design Testing", "file_type": "concept", "source_file": ".agents/skills/impeccable/reference/critique.md", "source_location": null, "source_url": null, "captured_at": null, "autho